              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 15 9530 (Hàng chính hãng)\",\n  \"description\": \"Core i9 13900H, 32GB RAM, 1TB SSD, RTX 4070. Máy đẹp like new.\",\n  \"startingPrice\": 35000000,\n  \"stepPrice\": 500000,\n  \"startTime\": \"2026-11-24T12:00:00Z\",\n  \"endTime\": \"2026-11-24T18:00:00Z\",\n  \"categoryId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        }
      ]
