    {
      "name": "04. Bidding (Đặt giá trực tuyến & Luồng nghiệp vụ)",
      "item": [
        {
          "name": "Happy Path: Đặt giá hợp lệ (POST /api/products/{id}/bids)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{bidderToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 2600000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1",
                "bids"
              ]
            }
          }
        },
        {
          "name": "Bắt lỗi 403: Seller tự đặt giá sản phẩm của chính mình (Kỳ vọng 403)",
