            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1/bids",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "1",
                "bids"
              ]
