{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "FrontendUrl": "http://localhost:3000",
  "Jwt": {
    "Issuer": "BidNet",
    "Audience": "BidNet",
    "ExpireMinutes": 60,
    "Key": "SuperSecretKeyForBidNetApplication_DoNotShare_12345!"
  },
  "JwtSettings": {
    "SecretKey": "SuperSecretKeyForBidNetApplication_DoNotShare_12345!",
    "Issuer": "BidNet",
    "Audience": "BidNet",
    "ExpiryMinutes": 60
  },
  "Auction": {
    "MinBidIncrement": 1000
  },
  "LiveAuction": {
    "MinWarningIntervalSeconds": 5
  }
}
